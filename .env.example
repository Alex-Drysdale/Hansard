# Copy to .env and edit. Every value here has a working default -- this file
# exists to document the knobs, not because anything must be set.
#
# No API key is needed: the Hansard API is public and unauthenticated.

# --- What to ingest ---------------------------------------------------------
# Commons or Lords.
HANSARD_HOUSE=Commons
# Inclusive date range, ISO format.
HANSARD_START_DATE=2026-01-01
HANSARD_END_DATE=2026-04-30

# --- Where to put it --------------------------------------------------------
HANSARD_DB_PATH=data/hansard.db

# --- How hard to push -------------------------------------------------------
# Self-imposed rate limit. Be conservative: this is a public service.
HANSARD_REQUESTS_PER_SECOND=5
HANSARD_TIMEOUT_SECONDS=30
HANSARD_MAX_RETRIES=4
HANSARD_PAGE_SIZE=100

# --- Where to get it from ---------------------------------------------------
# Override only to point at a mock server.
HANSARD_BASE_URL=https://hansard-api.parliament.uk
