# Copy to .env and edit. Every value here has a working default that matches
# docker-compose.yml, so a fresh clone needs no .env at all -- this file exists
# to document the knobs.
#
# No API keys: both Parliament APIs are public and unauthenticated.

# --- Where the data goes ----------------------------------------------------
HANSARD_DATABASE_URL=postgresql://hansard:hansard@localhost:5432/hansard

# Used by docker-compose to create the database. Change these together with the
# URL above, or neither.
POSTGRES_DB=hansard
POSTGRES_USER=hansard
POSTGRES_PASSWORD=hansard
# Host port only. Change it if 5432 is already taken by a local Postgres.
POSTGRES_PORT=5432

# --- What to ingest ---------------------------------------------------------
HANSARD_HOUSE=Commons
HANSARD_START_DATE=2026-01-01
HANSARD_END_DATE=2026-04-30

# --- How hard to push -------------------------------------------------------
# Self-imposed rate limit, shared by both APIs. Be conservative: these are
# public services, and nothing here is urgent.
HANSARD_REQUESTS_PER_SECOND=5
HANSARD_TIMEOUT_SECONDS=30
HANSARD_MAX_RETRIES=4
HANSARD_PAGE_SIZE=100

# --- Logging ----------------------------------------------------------------
# console for a terminal, json for a container or a log shipper.
HANSARD_LOG_LEVEL=INFO
HANSARD_LOG_FORMAT=console

# --- Where the data comes from ----------------------------------------------
# Override only to point at a mock server.
HANSARD_BASE_URL=https://hansard-api.parliament.uk
MEMBERS_BASE_URL=https://members-api.parliament.uk/api

# --- Retrieval (Phase 3) ----------------------------------------------------
# The vector index is a local directory, not a service. It is derived from
# Postgres and can be deleted and rebuilt at any time with `hansard index`.
HANSARD_VECTOR_PATH=data/vectors

# Embeddings run locally via ONNX -- no torch, no GPU, no API call. The model
# downloads once (~130MB) and is cached.
HANSARD_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Chunking. 350 words sits comfortably inside the model's 512-token limit;
# the overlap carries context across a boundary so a passage beginning "he said
# that" still has the sentence it refers to.
HANSARD_CHUNK_WORDS=350
HANSARD_CHUNK_OVERLAP_WORDS=60

# Worker processes for embedding. Each one loads its own copy of onnxruntime
# and the model -- about 1GB apiece on this machine -- so this is bounded by
# free RAM, not by core count. Four workers got an index build killed by the
# OS; two is still roughly twice as fast as serial.
HANSARD_EMBED_PARALLEL=2

# --- Answering --------------------------------------------------------------
# Any OpenAI-compatible endpoint. Groq by default; point LLM_BASE_URL at
# OpenAI, or at a local llama.cpp server, and nothing else changes.
#
# Retrieval works without a key -- `hansard ask --passages-only` and the web
# UI's "passages only" box both skip the model entirely. Only the written
# answer needs one.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Generous on purpose: gpt-oss is a reasoning model and spends most of a small
# budget thinking, then returns an empty string.
LLM_MAX_TOKENS=2000
